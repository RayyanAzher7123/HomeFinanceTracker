@using System.Text.Json
@model HomeFinance.web.Models.ExpenseSummaryPageViewModel

@{
    ViewData["Title"] = "Expense Summary";
}

<div class="container mt-5">
    <h2 class="text-center mb-4 display-6 fw-bold text-primary">📊 Expense Summary</h2>
    <p class="text-center text-muted mb-5">Visual overview of your spending patterns by category, month, and store.</p>

    <div class="row g-4">
        <!-- Category Summary -->
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h4 class="card-title text-center text-primary">Category-wise Expenses</h4>
                    <canvas id="categoryChart" height="100"></canvas>
                </div>
            </div>
        </div>

        <!-- Monthly Summary -->
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h4 class="card-title text-center text-success">Monthly Expense Trend</h4>
                    <canvas id="monthlyChart" height="100"></canvas>
                </div>
            </div>
        </div>

        <!-- Store Summary -->
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h4 class="card-title text-center text-warning">Store-wise Spending (Pie Chart)</h4>
                    <canvas id="storePieChart" height="100"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Category Chart
        const categoryLabels = @Html.Raw(Json.Serialize(Model.CategorySummary.Select(c => c.Category)));
        const categoryData = @Html.Raw(Json.Serialize(Model.CategorySummary.Select(c => c.TotalAmount)));

        new Chart(document.getElementById('categoryChart'), {
            type: 'bar',
            data: {
                labels: categoryLabels,
                datasets: [{
                    label: 'Total Spent ($)',
                    data: categoryData,
                    backgroundColor: 'rgba(54, 162, 235, 0.6)',
                    borderColor: 'rgba(54, 162, 235, 1)',
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true } }
            }
        });

        // Monthly Chart
        const monthLabels = @Html.Raw(Json.Serialize(Model.MonthSummary.Select(m => m.Month)));
        const monthData = @Html.Raw(Json.Serialize(Model.MonthSummary.Select(m => m.TotalAmount)));

        new Chart(document.getElementById('monthlyChart'), {
            type: 'line',
            data: {
                labels: monthLabels,
                datasets: [{
                    label: 'Total Spent ($)',
                    data: monthData,
                    borderColor: 'rgba(255, 99, 132, 1)',
                    backgroundColor: 'rgba(255, 99, 132, 0.2)',
                    fill: true,
                    tension: 0.4
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true } }
            }
        });

        // Store Pie Chart
        const storeLabels = @Html.Raw(JsonSerializer.Serialize(Model.StoreSummary.Select(s => s.Category)));
        const storeData = @Html.Raw(JsonSerializer.Serialize(Model.StoreSummary.Select(s => s.TotalAmount)));

        new Chart(document.getElementById('storePieChart'), {
            type: 'pie',
            data: {
                labels: storeLabels,
                datasets: [{
                    data: storeData,
                    backgroundColor: [
                        'rgba(255, 99, 132, 0.6)',
                        'rgba(54, 162, 235, 0.6)',
                        'rgba(255, 206, 86, 0.6)',
                        'rgba(75, 192, 192, 0.6)',
                        'rgba(153, 102, 255, 0.6)',
                        'rgba(255, 159, 64, 0.6)'
                    ],
                    borderColor: '#fff',
                    borderWidth: 2
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: {
                            boxWidth: 12,
                            padding: 15
                        }
                    }
                }
            }
        });
    </script>
}
