@model HomeFinance.web.Models.Expense

@{
    ViewData["Title"] = "Add New Expense";
}

<div class="container py-5">
    <h2 class="text-center text-success mb-4">➕ Add New Expense</h2>

    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <form asp-action="Create" method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <!-- Category -->
                        <div class="mb-3">
                            <label class="form-label">Category</label>
                            <select asp-for="Category" class="form-select" asp-items="ViewBag.CategoryList">
                                <option value="">-- Select Category --</option>
                            </select>
                            <span asp-validation-for="Category" class="text-danger"></span>
                        </div>

                        <!-- Description -->
                        <div class="mb-3">
                            <label asp-for="Description" class="form-label"></label>
                            <input asp-for="Description" class="form-control" />
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <!-- Amount -->
                        <div class="mb-3">
                            <label asp-for="Amount" class="form-label"></label>
                            <input asp-for="Amount" class="form-control" />
                            <span asp-validation-for="Amount" class="text-danger"></span>
                        </div>

                        <!-- Date -->
                        <div class="mb-3">
                            <label asp-for="Date" class="form-label"></label>
                            <input asp-for="Date" class="form-control" type="date" />
                            <span asp-validation-for="Date" class="text-danger"></span>
                        </div>

                        <!-- Store -->
                        <div class="mb-3">
                            <label asp-for="StoreId" class="form-label">Store</label>
                            <select asp-for="StoreId" class="form-select" asp-items="ViewBag.StoreId">
                                <option value="">-- Select Store --</option>
                            </select>
                            <span asp-validation-for="StoreId" class="text-danger"></span>
                        </div>

                        <!-- Bill Image -->
                        <div class="mb-4">
                            <label for="BillImage" class="form-label">Upload Bill Image (optional)</label>
                            <input type="file" name="BillImage" class="form-control" />
                        </div>

                        <!-- Submit Button -->
                        <div class="d-grid">
                            <button type="submit" class="btn btn-success">Save Expense</button>
                        </div>
                    </form>

                    <div class="mt-4 text-center">
                        <a asp-action="Index" class="text-decoration-none">← Back to Expense List</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
