@model HomeFinance.web.Models.Expense
@{
    ViewData["Title"] = "Expense Details";
}

<div class="container py-5">
    <h2 class="text-center text-primary mb-4">💡 Expense Details</h2>

    <div class="card shadow-sm border-0 mx-auto" style="max-width: 600px;">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-4 text-muted">Category:</dt>
                <dd class="col-sm-8">@Model.Category</dd>

                <dt class="col-sm-4 text-muted">Description:</dt>
                <dd class="col-sm-8">@Model.Description</dd>

                <dt class="col-sm-4 text-muted">Amount:</dt>
                <dd class="col-sm-8">$@Model.Amount</dd>

                <dt class="col-sm-4 text-muted">Date:</dt>
                <dd class="col-sm-8">@Model.Date.ToShortDateString()</dd>

                <dt class="col-sm-4 text-muted">Store:</dt>
                <dd class="col-sm-8">@Model.Store?.StoreName</dd>

                <dt class="col-sm-4 text-muted">Bill:</dt>
                <dd class="col-sm-8">
                    @if (!string.IsNullOrEmpty(Model.BillImagePath))
                    {
                        <a href="@Model.BillImagePath" target="_blank" class="btn btn-outline-primary btn-sm">View Bill</a>
                    }
                    else
                    {
                        <span class="text-muted">No Bill Available</span>
                    }
                </dd>
            </dl>

            <div class="d-flex justify-content-between mt-4">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </div>
    </div>
</div>
