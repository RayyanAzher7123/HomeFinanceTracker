@model HomeFinance.web.Models.Expense
@{
    ViewData["Title"] = "Delete Expense";
}

<div class="container py-5">
    <h2 class="text-center text-danger mb-4">⚠️ Confirm Delete</h2>

    <div class="card shadow-sm border-0 mx-auto" style="max-width: 600px;">
        <div class="card-body">
            <p class="lead text-center text-muted">Are you sure you want to delete this expense?</p>

            <dl class="row">
                <dt class="col-sm-4 text-muted">Category:</dt>
                <dd class="col-sm-8">@Model.Category</dd>

                <dt class="col-sm-4 text-muted">Description:</dt>
                <dd class="col-sm-8">@Model.Description</dd>

                <dt class="col-sm-4 text-muted">Amount:</dt>
                <dd class="col-sm-8">$@Model.Amount</dd>

                <dt class="col-sm-4 text-muted">Date:</dt>
                <dd class="col-sm-8">@Model.Date.ToShortDateString()</dd>

                <dt class="col-sm-4 text-muted">Store:</dt>
                <dd class="col-sm-8">@Model.Store?.StoreName</dd>
            </dl>

            <form asp-action="Delete">
                <input type="hidden" asp-for="Id" />
                <div class="d-flex justify-content-between mt-4">
                    <input type="submit" value="Delete" class="btn btn-danger" />
                    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
