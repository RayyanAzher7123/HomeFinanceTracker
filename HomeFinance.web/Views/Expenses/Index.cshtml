@model IEnumerable<HomeFinance.web.Models.Expense>

@{
    ViewData["Title"] = "All Expenses";
}

<div class="container py-4">
    <h2 class="mb-4 text-primary text-center">📋 All Expenses</h2>

    <div class="text-end mb-3">
        <a asp-action="Create" class="btn btn-success">➕ Add New Expense</a>
    </div>

    <table class="table table-bordered table-hover shadow-sm">
        <thead class="table-light">
            <tr>
                <th>Category</th>
                <th>Description</th>
                <th>Amount</th>
                <th>Date</th>
                <th>Store</th>
                <th>Bill</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Category</td>
                    <td>@item.Description</td>
                    <td>$@item.Amount</td>
                    <td>@item.Date.ToShortDateString()</td>
                    <td>@item.Store?.StoreName</td>
                    <td>
                        @if (!string.IsNullOrEmpty(item.BillImagePath))
                        {
                            <a class="btn btn-outline-primary btn-sm" href="@item.BillImagePath" target="_blank">View</a>
                        }
                        else
                        {
                            <span class="text-muted">No Bill</span>
                        }
                    </td>
                    <td>
                        <a class="btn btn-sm btn-info text-white" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                        <a class="btn btn-sm btn-secondary" asp-action="Details" asp-route-id="@item.Id">Details</a>
                        <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
