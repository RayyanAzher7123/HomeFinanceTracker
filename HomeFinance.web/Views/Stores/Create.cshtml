@model HomeFinance.web.Models.Store

@{
    ViewData["Title"] = "Add New Store";
}

<div class="container mt-5 d-flex justify-content-center">
    <div class="card shadow p-4 w-100" style="max-width: 500px;">
        <h2 class="text-center mb-4 text-primary">@ViewData["Title"]</h2>

        <form asp-action="Create" method="post">
            <div class="mb-3">
                <label asp-for="StoreName" class="form-label">Store Name</label>
                <input asp-for="StoreName" class="form-control" placeholder="e.g. Walmart, Costco, etc." />
                <span asp-validation-for="StoreName" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-success w-100">Save Store</button>
        </form>

        <div class="mt-3 text-center">
            <a asp-controller="Stores" asp-action="Index" class="text-decoration-none">
                ← Back to Store List
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
